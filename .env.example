APP_NAME="Магазин"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.ru
# Extra trusted hosts, comma separated (e.g. the Beget technical domain); others get 400 in production (D-057)
# SHOP_EXTRA_HOSTS=
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
ADMIN_PATH=admin

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=login_shop
# On Beget the user name equals the database name
DB_USERNAME=login_shop
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

MAIL_MAILER=smtp
# Local development: MAIL_MAILER=log and MAIL_LOG_CHANNEL=mail write e-mails to storage/logs/mail.log
MAIL_LOG_CHANNEL=
MAIL_HOST=
MAIL_PORT=
# Port 465 needs MAIL_SCHEME=smtps; port 587 uses STARTTLS and needs no scheme
# MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
